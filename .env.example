# ============================================================================
# AKRITA — environment configuration template
# ============================================================================
#
# Copy this file to `.env` and fill in real values when you cut over from
# MOCK_MODE=1 to live integrations. The default values here make the stack
# run end-to-end in MOCK_MODE without any external dependencies.

# ----- Mode -----------------------------------------------------------------
# 1 = use in-memory mock adapters (no API keys needed)
# 0 = use real Circle / Polymarket / Hyperliquid integrations (TODO Day 2+)
MOCK_MODE=1

# ----- Service ports --------------------------------------------------------
ORCHESTRATOR_PORT=8000

# ----- Arc network (testnet during hackathon) -------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# ----- Polygon (Polymarket V2 settles here) ---------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_EXPLORER_URL=https://polygonscan.com

# ----- Hyperliquid testnet --------------------------------------------------
HL_URL=https://api.hyperliquid-testnet.xyz

# ----- AKRITA contract addresses (set after `make contracts-deploy`) --------
TRACE_REGISTRY_ADDR=0x1111111111111111111111111111111111111111
BUILDER_REGISTRY_ADDR=0x2222222222222222222222222222222222222222

# ----- Polymarket V2 builder code (apply Day 1; allowlist 24-48h) -----------
# After admission, copy the bytes32 from polymarket.com/settings?tab=builder
POLY_BUILDER_CODE=0xababababababababababababababababababababababababababababababababab
POLY_RELAYER_URL=https://clob.polymarket.com

# ----- USYC ALLOWLIST (CRITICAL — file Day 1) -------------------------------
# Per docs.arc.io/arc/references/contract-addresses, request testnet USYC
# allowlisting via Circle Support ticket including your Arc testnet wallet.
# Processing time: 24-48 hours.
USYC_WALLET_ALLOWLISTED=false

# ----- Tunables -------------------------------------------------------------
# NOMOS (pricing)
PRICING_QUOTE_INTERVAL=10
APPETITE_PROFILE=balanced
# Optional: comma-separated bytes32 market IDs. Empty = use mock defaults.
SUBSCRIBED_MARKETS=

# SPATHA (hedge)
HEDGE_CHECK_INTERVAL=5
HEDGE_INVENTORY_THRESHOLD=500

# AGROS (treasury)
TREASURY_SWEEP_INTERVAL=60
SAFETY_MULTIPLIER=1.5
MIN_USDC_BUFFER=200
USYC_MIN_SUBSCRIBE=50

# ----- Secrets (DO NOT COMMIT) ----------------------------------------------
# Circle Developer Console API key (when MOCK_MODE=0)
CIRCLE_API_KEY=
# Polymarket relayer credentials (legacy V1; V2 uses just bytes32 builder code)
# Kept here in case you need the Magic Link / Safe deployment flow.
POLY_MAGIC_API_KEY=

# ----- LLM provider (NOMOS calibrator) --------------------------------------
# Mock LLM used by default; real impl plugs into 0G compute or Anthropic.
LLM_PROVIDER=mock
LLM_API_KEY=
