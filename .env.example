# ============================================================================
# AKRITA — environment configuration template
# ============================================================================
#
# Copy this file to `.env` and fill in real values. AKRITA runs against
# live integrations only — every external surface needs real credentials.
#
# Secrets that should not live in `.env` (JSON keystores, signed delegate
# certs) go under `secrets/`. See `secrets/README.md`.
#
# Phase ordering matches docs/LIVE_IMPLEMENTATION_PLAN.md.

# ----- Service ports --------------------------------------------------------
ORCHESTRATOR_PORT=8000
TRACE_SIDECAR_URL=http://trace-sidecar:8787

# ----- Arc network (testnet during hackathon) -------------------------------
# Per Arc docs: chain ID 5042002, USDC is native gas, sub-second finality.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_CHAIN_ID=5042002

# ----- Polygon (Polymarket V2 settles here) ---------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_EXPLORER_URL=https://polygonscan.com
# Optional dedicated WS endpoint for OrderFilled event subscription.
POLYGON_WS_URL=

# ----- Hyperliquid testnet --------------------------------------------------
HL_URL=https://api.hyperliquid-testnet.xyz
HL_ACCOUNT_ADDR=
HL_API_WALLET_ADDR=
# JSON keystore path for the HL API wallet; do NOT inline the key here.
HL_API_WALLET_KEYFILE=secrets/hl_api_wallet.json

# ----- AKRITA contract addresses (set after `make contracts-deploy`) --------
TRACE_REGISTRY_ADDR=
BUILDER_REGISTRY_ADDR=
SUSDE_ACCEPTANCE_ADDR=

# ----- Polymarket V2 builder code (Phase 0 critical path) -------------------
# Apply at polymarket.com immediately; allowlist takes 24-48h. After
# admission, copy the bytes32 from polymarket.com/settings?tab=builder.
POLY_BUILDER_CODE=
POLY_RELAYER_URL=https://clob.polymarket.com
# CLOB V2 API key set (created in the V2 dashboard).
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_COLLATERAL_READY=0

# ----- Circle (Wallets, Gateway, USYC, Nanopayments) ------------------------
CIRCLE_API_KEY=
CIRCLE_ENV=sandbox
# Wallet set + per-chain wallet IDs (populated by
# `scripts/bootstrap/create_circle_wallets.py`).
# Each EOA derives the same address across EVM chains; Circle issues a
# distinct wallet ID per (wallet, blockchain) pair.
CIRCLE_WALLET_SET_ID=
PRICING_WALLET_ADDR=
PRICING_WALLET_ID_ARC=
PRICING_WALLET_ID_MATIC=
HEDGE_WALLET_ADDR=
HEDGE_WALLET_ID_ARC=
HEDGE_WALLET_ID_MATIC=
TREASURY_WALLET_ADDR=
TREASURY_WALLET_ID_ARC=
TREASURY_WALLET_ID_MATIC=
TRACE_WALLET_ADDR=
TRACE_WALLET_ID_ARC=
TRACE_WALLET_ID_MATIC=

# ----- USYC testnet allowlist (Phase 0 critical path) -----------------------
# File the allowlist ticket on Day 1; processing 24-48h. Flip to true once
# the treasury wallet is approved.
USYC_WALLET_ALLOWLISTED=false

# ----- IPFS pin provider (used by the trace sidecar) ------------------------
# One of: pinata | web3storage
PIN_PROVIDER=pinata
PINATA_JWT=
WEB3_STORAGE_TOKEN=
# Optional 0G storage redundancy after IPFS pin succeeds.
ZEROG_ENDPOINT=
ZEROG_API_KEY=

# ----- Persistence (Phase 2) ------------------------------------------------
# Local-dev defaults; docker-compose overrides these to the in-network
# `postgres` / `redis` hostnames so the same .env works both modes.
POSTGRES_DSN=postgresql://akrita:akrita@localhost:5432/akrita
REDIS_URL=redis://localhost:6379/0

# ----- Tunables -------------------------------------------------------------
# NOMOS (pricing)
PRICING_QUOTE_INTERVAL=10
APPETITE_PROFILE=balanced
# Required: comma-separated bytes32 market IDs. Empty = NOMOS stays idle.
SUBSCRIBED_MARKETS=

# SPATHA (hedge)
HEDGE_CHECK_INTERVAL=5
HEDGE_INVENTORY_THRESHOLD=500

# AGROS (treasury)
TREASURY_SWEEP_INTERVAL=60
SAFETY_MULTIPLIER=1.5
MIN_USDC_BUFFER=200
USYC_MIN_SUBSCRIBE=50
# Projected next-hour USDC outflow estimate (drives the buffer target).
TREASURY_PROJECTED_OUTFLOW_USDC=200
# Hard per-action cap on any single subscribe/redeem/transfer (USDC),
# enforced server-side in the orchestrator.
TREASURY_MAX_ACTION_USDC=10

# ----- Safety controls (kill switches) --------------------------------------
# Set any to 1 to halt the matching subsystem at runtime.
KILL_SWITCH_GLOBAL=0
KILL_SWITCH_PRICING=0
KILL_SWITCH_HEDGE=0
KILL_SWITCH_TREASURY=0
# Per-wallet spend limits (USDC per 24h rolling window).
SPEND_LIMIT_PRICING=2500
SPEND_LIMIT_HEDGE=5000
SPEND_LIMIT_TREASURY=10000

# ----- LLM provider (NOMOS calibrator) --------------------------------------
# Reasoner model recorded in trace bodies. NOMOS uses the Anthropic SDK; set
# LLM_BASE_URL to override the default https://api.anthropic.com (e.g. when
# proxying through AgentRouter). LLM_AUTH_TOKEN is only required by routers
# that use a two-header auth scheme (x-api-key + Authorization: Bearer).
LLM_PROVIDER=
LLM_API_KEY=
LLM_AUTH_TOKEN=
LLM_BASE_URL=
AKRITA_REASONER_MODEL=
